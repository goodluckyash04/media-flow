# Django secret key - change this in production!
SECRET_KEY=django-insecure-change-this-to-a-random-50-char-string-before-use

# Debug mode (keep True for local use)
DEBUG=True

# Allowed hosts - keep as localhost for security
ALLOWED_HOSTS=127.0.0.1,localhost

# Default download directory (leave blank to use ~/Downloads/MediaDownloader)
DEFAULT_DOWNLOAD_DIR=

# Maximum concurrent download/conversion jobs
MAX_CONCURRENT_JOBS=3

# Default audio format: mp3, m4a, flac, wav, opus
DEFAULT_AUDIO_FORMAT=mp3

# Default audio quality: best, high (320k/192k), medium (128k), low (96k)
DEFAULT_AUDIO_QUALITY=high

# FFmpeg binary path (leave blank to auto-detect from PATH)
FFMPEG_PATH=

# FFprobe binary path (leave blank to auto-detect from PATH)
FFPROBE_PATH=

# Spotify integration (optional)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Port for the development server
SERVER_PORT=8000
